---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.slice(base.length) || '/';
const normalize = (path: string) =>
	path.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const isActive = typeof href === 'string' && normalize(href) === normalize(pathname);
const classes = [className, isActive ? 'active' : undefined].filter(Boolean).join(' ');
---

<a href={href} class={classes || undefined} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
