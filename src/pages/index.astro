---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getPosts, postDateObject, postHref, postTitle } from '../lib/posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} canonicalPath="/" />
		<style>
			main {
				width: 720px;
			}
			.post-list {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				padding: 1.25em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list li:last-child {
				border-bottom: none;
			}
			.post-list a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.post-list .title {
				margin: 0 0 0.25em 0;
				font-size: 1.563em;
				color: rgb(var(--black));
				line-height: 1.2;
			}
			.post-list .date {
				margin: 0;
				color: rgb(var(--gray));
			}
			.post-list a:hover .title,
			.post-list a:hover .date {
				color: rgb(var(--accent));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h2>Posts</h2>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={postHref(post)}>
								<h3 class="title">
									{postTitle(post)}
								</h3>
								<p class="date">
									<FormattedDate date={postDateObject(post)} />
								</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
