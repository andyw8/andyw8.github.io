{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Deployed by Workers Builds (build: npm run build, deploy: npx wrangler deploy).
	// The name must match the Worker the build system deploys to.
	"name": "andyw8-github-io",
	// Update to today's date when changing this file.
	"compatibility_date": "2026-11-14",
	"assets": {
		"directory": "./dist",
		// Serve dist/**/<slug>.html at the extension-less path and 308 the `.html`
		// form, matching how the canonical URLs are generated. This is the default,
		// but spelling it out documents why the site's URLs look the way they do.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
